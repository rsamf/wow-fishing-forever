# wowfish configuration. Delete any line to go back to its default.

[game]
# Keybind for the Fishing ability on your action bar.
cast_key = "1"
# Keybind for Interact With Target (Options > Keybindings > Targeting).
interact_key = "f"
# Stop fishing after this many minutes. Set to 0 to run Forever!
session_minutes = 0
# Keybind of an action bar macro containing /quit. When session_minutes runs out, the bot
# finishes the cast in hand, then presses it until the game window closes (3 tries at most).
# Empty = leave the game running.
quit_key = ""
# Keybind for a lure macro, e.g. "/use Shiny Bauble" then "/use 16" (puts it on the main-hand
# fishing pole). The bot presses it before the first cast and again every lure_minutes. If the
# lure is not in your bags, the macro does nothing. Empty = no lure.
lure_key = ""
# How long the lure's buff lasts, in minutes.
lure_minutes = 10.0

[vision]
# Frames wider than this are downscaled before matching.
match_width = 1920

[audio]
# The bot hears only the app of the game window you pick (Linux PipeWire, Windows 10 2004+), so
# music or videos in other applications cannot drown the splash.
# macOS only: name of the input device the game's sound is routed into. Empty = BlackHole (or
# another virtual device). Linux and Windows ignore this.
device = ""
# Any audio matching score above this threshold will be classified as a bite 
bite_threshold = 0.66
# Ignore further bites for this many seconds after one fires.
refractory_s = 3.0

[run]
# Recast if the gear icon is not seen this many seconds after casting.
icon_timeout_s = 4.0
# Recast if no splash is heard this many seconds after casting.
cast_timeout_s = 30.0
# Count a miss if the bobber is still there this many seconds after pressing Interact.
loot_timeout_s = 3.0
# Random pause between actions, in seconds.
pause_min_s = 0.5
pause_max_s = 2.0
# How long each key is held down, in milliseconds.
key_hold_ms = 60
# Seconds to wait after pressing lure_key for the lure to finish applying before casting.
lure_cast_s = 6.0
# true = keep fishing while you use another window: on a splash the bot brings the game to the
# front, presses Interact, loots, casts again and gives focus back. Needs "Sound in Background"
# on in the game. false = the bot pauses whenever the game is not the focused window.
background = false

[behavior]
# Variations so the bot does not keep the exact same rhythm. All of them are off by default.
# Take a break after fishing for a random number of minutes between these two.
# 0 = never take a break.
break_every_min_minutes = 0.0
break_every_max_minutes = 0.0
# How long each break lasts, in minutes, picked at random between these two.
break_min_minutes = 0.0
break_max_minutes = 0.0
# Wait a random number of milliseconds between these two after hearing the splash, before
# pressing Interact. Keep it under a second or so, or the fish gets away.
reaction_min_ms = 0
reaction_max_ms = 0
# Chance (0..1) of letting a bite go on purpose, as if it was missed.
skip_bite_chance = 0.0
# Hold each key for run.key_hold_ms, give or take up to this many milliseconds.
key_hold_jitter_ms = 0
# Chance (0..1) of jumping in place before a cast, and the Jump keybind.
jump_chance = 0.0
jump_key = "space"
